{
  "name": "inspectuser",
  "private": true,
  "workspaces": [
    "dashboard",
    "packages/*"
  ],
  "scripts": {
    "dev:dashboard": "pnpm --filter @inspectuser/dashboard dev",
    "build:sdk": "pnpm --filter @inspectuser/browser build",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down"
  },
  "packageManager": "pnpm@9.15.4"
}
