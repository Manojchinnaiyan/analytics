{%- comment -%}
  InspectUser app embed — loads the full SDK in the real page (autocapture + replay).
  Config comes from the block settings; endpoints default to production.
{%- endcomment -%}
{%- if block.settings.api_key != blank -%}
  <script src="{{ 'inspectuser.js' | asset_url }}" defer></script>
  <script>
    window.addEventListener('load', function () {
      if (!window.InspectUser || !window.InspectUser.init) return;
      window.InspectUser.init({
        apiKey: {{ block.settings.api_key | json }},
        serverUrl: {{ block.settings.ingest_url | json }},
        autoCapture: {
          pageViews: true,
          clicks: true,
          formSubmissions: true,
          scrollDepth: true,
          rageClicks: true,
          deadClicks: true,
          webVitals: true,
          errors: true
        },
        sessionReplay: {
          enabled: {% if block.settings.session_replay %}true{% else %}false{% endif %},
          serverUrl: {{ block.settings.replay_url | json }},
          sampleRate: {{ block.settings.sample_rate | default: 1.0 }},
          maskAllInputs: true
        }
      });
    });
  </script>
{%- endif -%}

{% schema %}
{
  "name": "InspectUser",
  "target": "head",
  "settings": [
    {
      "type": "paragraph",
      "content": "Paste your InspectUser project API key (InspectUser → Settings → API keys). Enables autocapture + session replay on your storefront."
    },
    { "type": "text", "id": "api_key", "label": "InspectUser API key" },
    { "type": "checkbox", "id": "session_replay", "label": "Enable session replay", "default": true },
    { "type": "range", "id": "sample_rate", "label": "Session sample rate", "min": 0.1, "max": 1.0, "step": 0.1, "default": 1.0 },
    { "type": "text", "id": "ingest_url", "label": "Ingest URL", "default": "https://ingest.inspectuser.com" },
    { "type": "text", "id": "replay_url", "label": "Replay URL", "default": "https://api.inspectuser.com" }
  ]
}
{% endschema %}
