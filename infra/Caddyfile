# Behind a Cloudflare Tunnel: TLS terminates at Cloudflare's edge and cloudflared
# reaches Caddy over the internal Docker network — so Caddy serves plain HTTP only
# (no certs, no public ports). Each block = one hostname → internal service.
{
	auto_https off
}

http://{$APP_DOMAIN} {
	reverse_proxy dashboard:3000
}

http://{$API_DOMAIN} {
	reverse_proxy query:4001
}

http://{$INGEST_DOMAIN} {
	reverse_proxy ingestion:4000
}

# Branded short-link domain: go.<domain>/<slug> → ingestion's redirect handler.
http://{$SHORTLINK_DOMAIN:go.inspectuser.com} {
	reverse_proxy ingestion:4000
}

# Apex + www also resolve short links: inspectuser.com/<slug>. Bare root bounces
# to the app (no marketing site yet); everything else → redirect handler.
http://inspectuser.com, http://www.inspectuser.com {
	@root path /
	redir @root https://app.inspectuser.com 302
	reverse_proxy ingestion:4000
}
