# Auto-HTTPS reverse proxy. Each block = one public subdomain → internal service.
# Caddy fetches & renews Let's Encrypt certs automatically (needs ports 80/443
# open and the domains' DNS A-records pointing at this server's IP).

{$APP_DOMAIN} {
	reverse_proxy dashboard:3000
}

{$API_DOMAIN} {
	reverse_proxy query:4001
}

{$INGEST_DOMAIN} {
	reverse_proxy ingestion:4000
}

# Branded short-link domain: go.<domain>/<slug> → ingestion's redirect handler
# (records the click, then 302s to the destination). Needs a DNS A-record for
# this host → server IP so Caddy can issue its cert.
{$SHORTLINK_DOMAIN:go.inspectuser.com} {
	reverse_proxy ingestion:4000
}

# Apex + www also resolve short links: inspectuser.com/<slug> and
# www.inspectuser.com/<slug>. The bare root bounces to the app (the domain has
# no marketing site yet). Needs apex + www DNS pointing at this server.
inspectuser.com, www.inspectuser.com {
	@root path /
	redir @root https://app.inspectuser.com 302
	reverse_proxy ingestion:4000
}
