# Copy to `.env` on the server and fill in. NEVER commit the real .env.
# Generate strong secrets, e.g.:  openssl rand -hex 32

# ── Your domains (point these DNS A-records at the server IP) ────────────────
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com
INGEST_DOMAIN=ingest.example.com

# Public URLs the browser uses (baked into the dashboard build — must be https).
PUBLIC_APP_URL=https://app.example.com
PUBLIC_API_URL=https://api.example.com
PUBLIC_INGEST_URL=https://ingest.example.com

# ── Secrets (CHANGE ALL OF THESE) ────────────────────────────────────────────
JWT_SECRET=replace-with-openssl-rand-hex-32
CLICKHOUSE_USER=inspectuser
CLICKHOUSE_PASSWORD=replace-with-strong-password
CLICKHOUSE_DB=inspectuser
POSTGRES_USER=inspectuser
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_DB=inspectuser

# ── Kafka (internal) ─────────────────────────────────────────────────────────
KAFKA_TOPIC=events
KAFKA_GROUP_ID=worker-group

# ── Branding (optional) ──────────────────────────────────────────────────────
BRAND_NAME=InspectUser
BRAND_TAGLINE=Clarity for every product decision.
BRAND_SCOPE=@inspectuser

# ── Session-replay / warehouse-export object storage (Cloudflare R2 / S3) ─────
# Leave R2_ENDPOINT empty to use the free ClickHouse blob store instead.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=inspectuser-replays

# ── Team-invite email (optional; empty SMTP_HOST = invites return a link) ─────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=InspectUser <no-reply@example.com>
