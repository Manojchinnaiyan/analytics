# Ingestion Service
PORT=4000
KAFKA_BROKER=localhost:9092
KAFKA_TOPIC=events
REDIS_ADDR=localhost:6379
POSTGRES_DSN=postgres://amplitude:amplitude_secret@localhost:5432/amplitude?sslmode=disable

# Worker Service
CLICKHOUSE_DSN=clickhouse://amplitude:amplitude_secret@localhost:9000/amplitude
KAFKA_GROUP_ID=amplitude-worker
BATCH_SIZE=5000
FLUSH_INTERVAL_MS=1000

# Query Service
QUERY_PORT=4001

# Dashboard
NEXT_PUBLIC_QUERY_API_URL=http://localhost:4001
NEXT_PUBLIC_INGESTION_API_URL=http://localhost:4000
